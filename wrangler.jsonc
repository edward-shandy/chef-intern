{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chef-intern",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./dist" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
