{
  "name": "chef-intern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node scripts/ensure-dist.mjs && wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "wrangler": "^4.76.0"
  }
}
